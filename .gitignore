*.o
*.obj
*.pdb
*.ilk
*.log
*.tmp

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.vs/

# Signing keys and secrets
*.pfx
*.pem
*.key
secrets.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini
